rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ─── Avatar uploads ───────────────────────────────────────────────────────
    // Path: avatars/{userId}/avatar.jpg
    match /avatars/{userId}/{fileName} {
      // Anyone authenticated can read avatars (for leaderboard / profile views)
      allow read: if isAuth();

      // Only the owner can upload their own avatar
      allow write: if isOwner(userId)
        && isImage()
        && isUnder5MB();

      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── Tournament images ────────────────────────────────────────────────────
    // Path: tournament_images/{tournamentId}/{fileName}
    match /tournament_images/{tournamentId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && isImage() && isUnder5MB();
      allow delete: if isAuth();
    }

    // ─── Venue images ─────────────────────────────────────────────────────────
    // Path: venue_images/{venueId}/{fileName}
    match /venue_images/{venueId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && isImage() && isUnder5MB();
      allow delete: if isAuth();
    }

    // ─── Payment receipts ─────────────────────────────────────────────────────
    // Path: receipts/{bookingId}
    match /receipts/{bookingId} {
      allow read: if isAuth();
      allow write: if isAuth() && isImage() && isUnder5MB();
      allow delete: if isAuth();
    }

    // ─── Default: deny ────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
